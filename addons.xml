<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.tv247" name="TV247 Repository" version="1.0.2" provider-name="ashcan57">
  <requires>
    <import addon="xbmc.addon" version="17.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="TV247 Repository">
    <dir>
      <info compressed="false">https://ashcan57.github.io/tv247/addons.xml</info>
      <checksum>https://ashcan57.github.io/tv247/addons.xml.md5</checksum>
      <datadir zip="true">https://ashcan57.github.io/tv247/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">TV247 Repository</summary>
    <description lang="en">TV247 Repository for family and friends.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
<addon id="plugin.program.tv247.wizard" name="TV247 Wizard" version="1.0.3" provider-name="ashcan57">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">TV247 Wizard</summary>
    <description lang="en">Install the Matrix Kodi build from TV247.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
</addons>
